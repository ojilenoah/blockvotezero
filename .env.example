# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored.

# Demo mode — OFF by default. The app reads from the live Polygon contract
# at VITE_CONTRACT_ADDRESS. Set to true to swap in a Supabase-backed mock
# (elections / candidates / votes live in DB tables, no MetaMask needed) —
# useful for offline dev or screenshots when the contract is unreachable.
VITE_DEMO_MODE=false

# Supabase — Project Settings → API Keys in the Supabase dashboard.
# Use the new "Publishable key" (starts with sb_publishable_...) — it is
# the modern replacement for the legacy anon JWT and is safe to ship to
# browsers because RLS policies still control what it can read/write.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Polygon Amoy contract address
VITE_CONTRACT_ADDRESS=0xc0895D39fBBD1918067d5Fa41beDAF51d36665B5

# RPC endpoint for Polygon Amoy.
# Leave blank to use the free public RPC (https://rpc-amoy.polygon.technology/).
# Set to a private endpoint (Alchemy / dRPC / QuickNode) for 5-10x faster loads:
#   https://polygon-amoy.g.alchemy.com/v2/<your-key>
# When this is set, the client also disables internal rate-limiting.
VITE_RPC_URL=

# Etherscan V2 API key — strongly recommended for the Explorer page.
# Without it, the contract-transactions list relies on eth_getLogs over the
# public RPC, which is rate-limited and often returns nothing past a few
# hours of history. With it, the Explorer instantly pulls every transaction
# ever sent to the contract.
#
# Grab a free key (works for ALL chains including Polygon Amoy):
#   1. Sign up at https://etherscan.io/register
#   2. Visit https://etherscan.io/myapikey → "Add"
#   3. Paste the key below
# Free tier: 5 requests/sec, 100k requests/day — plenty for this app.
VITE_ETHERSCAN_API_KEY=

# (Optional) Postgres direct URL — only needed if you use a Drizzle/Express path
DATABASE_URL=
